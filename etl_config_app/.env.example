# Пример окружения конфигуратора — ТОЛЬКО имена переменных, без значений.
# Реальные значения PROD: ~/.config/etl_config/prod.env (каталог 700, файл 600, вне репозитория),
# заполняются из Airflow connections (etl_prod, mssql_1c_conn). Не коммитить файл с реальными значениями.

# PostgreSQL etl_meta — обязательно, без них конфигуратор не стартует
ETL_CONFIG_DB_NAME=
ETL_CONFIG_DB_USER=
ETL_CONFIG_DB_PASSWORD=
ETL_CONFIG_DB_HOST=
ETL_CONFIG_DB_PORT=
ETL_CONFIG_ENV_LABEL=
ETL_CONFIG_ALLOW_DESTRUCTIVE=

# retail — обязательно для страниц retail (проверяется до подключения)
ETL_CONFIG_RETAIL_DB_HOST=
ETL_CONFIG_RETAIL_DB_PORT=
ETL_CONFIG_RETAIL_DB_NAME=
ETL_CONFIG_RETAIL_DB_USER=
ETL_CONFIG_RETAIL_DB_PASSWORD=

# 1С MSSQL — обязательно для обнаружения типов регистратора (проверяется до подключения)
ETL_CONFIG_MSSQL_SERVER=
ETL_CONFIG_MSSQL_PORT=
ETL_CONFIG_MSSQL_DATABASE=
ETL_CONFIG_MSSQL_USER=
ETL_CONFIG_MSSQL_PASSWORD=
